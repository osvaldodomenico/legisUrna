# Banco Postgres (obrigatório para gravar votos e apurar).
# Local: docker run -e POSTGRES_PASSWORD=urna -p 5432:5432 -d postgres:16
# Produção/ShiftLegis: use a URL fornecida pelo provedor.
DATABASE_URL=postgres://postgres:urna@localhost:5432/postgres

# Senha da tela /apuracao (protege a leitura dos resultados).
APURACAO_SENHA=troque-esta-senha

# Aplicar o schema em um banco novo: psql "$DATABASE_URL" -f db/schema.sql
